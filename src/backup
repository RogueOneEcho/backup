#!/usr/bin/env bash
set -euo pipefail

source ./logging
source ./file-env

file-env B2_APPLICATION_KEY
file-env B2_APPLICATION_KEY_ID
file-env RESTIC_PASSWORD

NAME="${NAME:-}"
SOURCE="${SOURCE:-/srv/${NAME}/}"
STAGING_DIR="/app/sqlite/"
EXCLUDE_PATH="/app/exclude"
B2_APPLICATION_KEY="${B2_APPLICATION_KEY:-}"
B2_APPLICATION_KEY_ID="${B2_APPLICATION_KEY_ID:-}"
B2_BUCKET="${B2_BUCKET:-}"
RESTIC_PASSWORD="${RESTIC_PASSWORD:-}"
RESTIC_PROGRESS_FPS="${RESTIC_PROGRESS_FPS:-0.1}"
AWS_SECRET_ACCESS_KEY="${B2_APPLICATION_KEY}"
AWS_ACCESS_KEY_ID="${B2_APPLICATION_KEY_ID}"
RESTIC_REPO="${RESTIC_REPO:-s3:https://s3.us-west-001.backblazeb2.com/${B2_BUCKET}/restic/${NAME}}"

redact () {
  if [[ -n "$1" ]]
  then
    echo '[REDACTED]'
  else
    echo '[NOT SET]'
  fi
}

start-timer () {
  START_TIME=$(date +%s)
}

stop-timer () {
  TIMER=$(($(date +%s) - START_TIME))
  START_TIME=0
}

log-vars () {
  log-debug "NAME: ${NAME}"
  log-debug "SOURCE: ${SOURCE}"
  log-debug "STAGING_DIR: ${STAGING_DIR}"
  log-debug "B2_APPLICATION_KEY: $(redact "${B2_APPLICATION_KEY}")"
  log-debug "B2_APPLICATION_KEY_ID: $(redact "${B2_APPLICATION_KEY_ID}")"
  log-debug "B2_BUCKET: ${B2_BUCKET}"
  log-debug "RESTIC_PASSWORD: $(redact "${RESTIC_PASSWORD}")"
  log-debug "RESTIC_PROGRESS_FPS: ${RESTIC_PROGRESS_FPS}"
  if [[ ! -f "${EXCLUDE_PATH}" ]]
  then
    touch "${EXCLUDE_PATH}"
  fi
  EXCLUDE_CONTENT=$(cat "${EXCLUDE_PATH}")
  log-debug "EXCLUDING:\n${EXCLUDE_CONTENT}"
}

read-excludes () {
  EXCLUDES=()
  while IFS= read -r PATTERN || [[ -n "${PATTERN}" ]]
  do
    if [[ -n "${PATTERN}" ]]
    then
      EXCLUDES+=("${PATTERN}")
    fi
  done < "${EXCLUDE_PATH}"
}

check-vars () {
  if [[ -z "${NAME}" ]]
  then
    log-warning "NAME must be set"
    return 1
  fi
  if [[ "${NAME}" == */* || "${NAME}" == "." || "${NAME}" == ".." ]]
  then
    log-warning "NAME must not contain a slash or be . or .."
    return 1
  fi
  if [[ -z "${B2_APPLICATION_KEY}" ]]
  then
    log-warning "B2_APPLICATION_KEY must be set"
    return 1
  fi
  if [[ -z "${B2_APPLICATION_KEY_ID}" ]]
  then
    log-warning "B2_APPLICATION_KEY_ID must be set"
    return 1
  fi
  if [[ -z "${B2_BUCKET}" ]]
  then
    log-warning "B2_BUCKET must be set"
    return 1
  fi
  if [[ -z "${RESTIC_PASSWORD}" ]]
  then
    log-warning "RESTIC_PASSWORD must be set"
    return 1
  fi
  if [[ "$SOURCE" != /* ]]
  then
    log-warning "SOURCE must be an absolute path"
    return 1
  fi
  if [[ "$SOURCE" != */ ]]
  then
    log-warning "SOURCE must end with a slash"
    return 1
  fi
  for PATTERN in "${EXCLUDES[@]}"
  do
    if [[ "${PATTERN}" == /* ]]
    then
      log-warning "Exclude ${PATTERN} must be relative to SOURCE"
      return 1
    fi
  done
  if [[ ! -d "${SOURCE}" ]]
  then
    log-warning "${SOURCE} is not a directory"
    return 1
  fi
  FILE_COUNT=$(ls -1A "${SOURCE}" | wc -l)
  if [[ "${FILE_COUNT}" -gt 0 ]]
  then
    log-debug "${SOURCE} contains ${FILE_COUNT} files or directories"
    return 0
  else
    log-warning "${SOURCE} appears to be empty"
    log-warning "Ensure the directory has permissions for user: $(id)"
    log-warning "and add at least one file with: touch ${SOURCE}/.not-empty"
    return 1
  fi
}

prepare-staging () {
  if ! mkdir -p "${STAGING_DIR}"
  then
    log-error "Failed to create staging directory: ${STAGING_DIR}"
    exit 1
  fi
  if [[ -n "$(ls -A "${STAGING_DIR}")" ]]
  then
    log-error "${STAGING_DIR} is not empty"
    log-error "Run each backup in a new container, e.g. docker compose run --rm"
    exit 1
  fi
}

build-find-args () {
  FIND_ARGS=()
  for PATTERN in "${EXCLUDES[@]}"
  do
    FIND_ARGS+=(-path "${SOURCE}${PATTERN}" -prune -o)
  done
  FIND_ARGS+=(-type f \( -name "*.db" -o -name "*.sqlite" -o -name "*.sqlite3" \) -print)
}

build-exclude-args () {
  EXCLUDE_ARGS=()
  for PATTERN in "*.db" "*.db-*" "*.sqlite" "*.sqlite-*" "*.sqlite3" "*.sqlite3-*"
  do
    EXCLUDE_ARGS+=(--exclude "${SOURCE}**/${PATTERN}")
  done
  for PATTERN in "${EXCLUDES[@]}"
  do
    EXCLUDE_ARGS+=(--exclude "${SOURCE}${PATTERN}")
  done
}

backup-databases () {
  log-information "Searching for sqlite databases"
  start-timer
  build-find-args
  set +e
  DATABASES=$(find "${SOURCE}" "${FIND_ARGS[@]}")
  set -e
  stop-timer
  if [[ -n "${DATABASES}" ]]
  then
    DB_COUNT=$(echo "${DATABASES}" | wc -l)
  else
    DB_COUNT=0
  fi
  log-debug "Found ${DB_COUNT} sqlite databases (${TIMER}s)"

  if [[ -z "${DATABASES}" ]]
  then
    log-information "No sqlite databases found"
    return 0
  fi

  log-information "Exporting ${DB_COUNT} databases"
  while IFS= read -r DB
  do
    TARGET_DB="${STAGING_DIR}${DB#"${SOURCE}"}"
    if ! mkdir -p "$(dirname "${TARGET_DB}")"
    then
      log-error "Failed to create directory for: ${TARGET_DB}"
      exit 1
    fi
    if ! quick-check-db
    then
      copy-db
      continue
    fi
    if ! integrity-check-db
    then
      copy-db
      continue
    fi
    log-debug "Exporting: ${DB}"
    start-timer
    log-trace "To: ${TARGET_DB}"
    if ! export-db
    then
      copy-db
      continue
    fi
  done <<< "${DATABASES}"

  log-success "Backed up ${DB_COUNT} sqlite databases"
}

quick-check-db () {
  log-debug "Quick checking: ${DB}"
  start-timer
  set +e
  ERR=$(sqlite3 "${DB}" ".timeout 10000;" "PRAGMA quick_check" 2>&1)
  set -e
  if [[ "${ERR}" == "ok" ]]
  then
    stop-timer
    log-debug "Checked (${TIMER}s): ${DB}"
    return 0
  else
    stop-timer
    log-warning "Failed quick check (${TIMER}s): ${DB}"
    log-warning "${ERR}"
    return 1
  fi
}

integrity-check-db () {
  log-debug "Integrity checking: ${DB}"
  start-timer
  set +e
  ERR=$(sqlite3 "${DB}" ".timeout 10000;" "PRAGMA integrity_check" 2>&1)
  set -e
  if [[ "${ERR}" == "ok" ]]
  then
    stop-timer
    log-debug "Checked (${TIMER}s): ${DB}"
    return 0
  else
    stop-timer
    log-warning "Failed integrity check (${TIMER}s): ${DB}"
    log-warning "${ERR}"
    return 1
  fi
}

export-db () {
  TARGET_SQL="${TARGET_DB//\'/\'\'}"
  set +e
  ERR=$(sqlite3 "${DB}" ".timeout 10000;" "VACUUM INTO '${TARGET_SQL}'" 2>&1)
  STATUS=$?
  set -e
  if [[ "${STATUS}" -eq 0 && -z "${ERR}" ]]
  then
    stop-timer
    log-debug "Exported (${TIMER}s): ${DB}"
    return 0
  else
    stop-timer
    log-warning "Failed to export database (${TIMER}s): ${DB}"
    log-warning "${ERR}"
    return 1
  fi
}

copy-db () {
  log-info "Attempting to copy instead"
  if cp "${DB}" "${TARGET_DB}"
  then
    log-debug "Copied database: ${DB}"
    return 0
  else
    log-error "Failed to copy database: ${DB}"
    return 1
  fi
}

restic-init () {
  export AWS_SECRET_ACCESS_KEY
  export AWS_ACCESS_KEY_ID
  export RESTIC_PASSWORD
  export RESTIC_PROGRESS_FPS
  if restic snapshots --repo "${RESTIC_REPO}" >/dev/null 2>&1
  then
    log-debug "Restic repository exists"
    return 0
  fi
  log-information "Creating restic repository"
  start-timer
  if restic init --repo "${RESTIC_REPO}"
  then
    stop-timer
    log-success "Created restic repository (${TIMER}s)"
    return 0
  else
    stop-timer
    log-error "Failed to create restic repository (${TIMER}s)"
    return 1
  fi
}

restic-backup () {
  log-information "Running restic backup"
  start-timer
  build-exclude-args
  if restic backup \
      --repo "${RESTIC_REPO}" \
      --host "${NAME}" \
      --group-by '' \
      "${EXCLUDE_ARGS[@]}" \
      "${SOURCE}" \
      "${STAGING_DIR}"
  then
    stop-timer
    log-success "Backup complete (${TIMER}s)"
    return 0
  else
    stop-timer
    log-error "Backup failed (${TIMER}s)"
    return 1
  fi
}

restic-forget () {
  log-information "Pruning old restic snapshots"
  start-timer
  if restic forget \
      --repo "${RESTIC_REPO}" \
      --group-by '' \
      --compact \
      --keep-within 14d \
      --keep-weekly 4 \
      --keep-monthly 12 \
      --prune
  then
    stop-timer
    log-success "Pruned old restic snapshots (${TIMER}s)"
    return 0
  else
    stop-timer
    log-error "Failed to prune restic snapshots (${TIMER}s)"
    return 1
  fi
}

restic-check () {
  log-information "Verifying restic backup integrity"
  start-timer
  if restic check --repo "${RESTIC_REPO}"
  then
    stop-timer
    log-success "Backup verified (${TIMER}s)"
    return 0
  else
    stop-timer
    log-error "Backup verification failed (${TIMER}s)"
    return 1
  fi
}

log-vars
read-excludes
check-vars
prepare-staging
backup-databases
restic-init
restic-backup
restic-forget
restic-check

